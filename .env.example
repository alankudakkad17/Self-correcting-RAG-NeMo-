# Copy to .env (git-ignored) and fill in. Never commit the real key.
# Get a key at https://build.nvidia.com (profile -> API keys).
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Wikipedia fact check: Wikimedia requires contact info in the User-Agent (an email or URL you own).
# Without it the check reports an error and the Verifier keeps the model's verdicts.
WIKIPEDIA_CONTACT=

# Optional overrides
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Set to 0 to bypass the LLM cache (e.g. for latency measurements)
LLM_CACHE_ENABLED=1
